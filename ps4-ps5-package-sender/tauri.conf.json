{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PS4-PS5 Package Sender",
  "version": "1.0.0",
  "identifier": "com.pkgsender.ps4",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PS4-PS5 Package Sender",
        "width": 1300,
        "height": 820,
        "minWidth": 980,
        "minHeight": 620,
        "decorations": false,
        "shadow": true,
        "center": true,
        "dragDropEnabled": true,
        "backgroundColor": "#0b0b0c"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  }
}
